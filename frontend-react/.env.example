# Copy this file to .env to override the backend URL in development.
# Without this file, all /api/* requests are proxied to http://localhost:5000
# via the "proxy" field in package.json (CRA dev server only).

# Override if your Flask backend runs on a different port or host:
# REACT_APP_API_BASE_URL=http://localhost:5000

# Leave blank to use the CRA proxy (recommended for local dev):
REACT_APP_API_BASE_URL=

